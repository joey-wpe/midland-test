# Backend under test.
WP_GRAPHQL_URL=https://headlessblogw1.wpenginepowered.com/graphql

# Gates every revalidation endpoint. Set the same value in the Atlas
# environment variables UI. The harness redacts it from logged URLs.
REVALIDATE_SECRET=change-me

# Optional: WordPress Application Password, so the harness can publish a change
# automatically instead of prompting for a manual edit in wp-admin.
# Create at wp-admin > Users > Profile > Application Passwords.
WP_USER=
WP_APP_PASSWORD=
